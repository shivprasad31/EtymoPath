# Copy these values into your shell or a local .env loader. Never commit real secrets.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata

# SQLite is the default and needs no database server.
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# For MySQL: set DB_ENGINE=mysql and install requirements-mysql.txt.
DB_NAME=etymopath
DB_USER=etymopath_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Password reset links print to the terminal unless an SMTP backend is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and provide:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
